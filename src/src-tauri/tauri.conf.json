{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "游伴 YouBan",
  "version": "0.2.0",
  "identifier": "com.offcircle.youban",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "游伴 YouBan",
        "width": 1240,
        "height": 800,
        "minWidth": 440,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "../data/games/*.json": "games/"
    }
  }
}
