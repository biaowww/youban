# youban-bff 环境变量（真实值放 .env，属主 youban、权限 600，绝不进 git）
HOST=127.0.0.1
PORT=8302
PUBLIC_BASE_URL=http://127.0.0.1:8302
# 经 kong 的自托管 Supabase 网关
SUPABASE_URL=http://127.0.0.1:8000
# 取自 /opt/youban/supabase/.env 的 SERVICE_ROLE_KEY，只在服务端
SUPABASE_SERVICE_ROLE_KEY=
# BFF 会话/state 签名密钥：openssl rand -hex 32
SESSION_JWT_SECRET=
# Steam Web API key（https://steamcommunity.com/dev/apikey）；绑定流程不需要，拉数据需要
STEAM_API_KEY=
