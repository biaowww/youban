# 游伴 youban-bff · 环境变量样例（复制为 .env；.env 已 gitignore，绝不提交）

PORT=8787
CORS_ORIGIN=*

# 大模型：glm（默认）| mock（无 key 本地跑 UI）
PROVIDER=glm
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL_CHAT=glm-5
GLM_MODEL_LITE=glm-4.5-flash

# 记忆策略
HISTORY_MESSAGES=10
PROFILE_EVERY_TURNS=3
BRIEF_MAX_CHARS=3200

# 存储：file（默认，本地 JSON 到 backend/bff/data）| supabase（线上）
COMPANION_STORE=file
# COMPANION_STORE=supabase
# SUPABASE_URL=http://127.0.0.1:8000
# SERVICE_ROLE_KEY=

# 游戏内容目录（默认仓库 src/data/games；服务器上指向 /opt/youban/repo/src/data/games）
# GAMES_DIR=
